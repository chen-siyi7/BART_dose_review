\name{bartDoseReview-package}
\alias{bartDoseReview-package}
\alias{bartDoseReview}
\docType{package}
\title{Review and Explanation of BART-Guided Dose Recommendations}
\description{
Functions for determining dose recommendations from numerical intervals,
selecting supporting reports, evaluating sensitivity and drawing independent
posterior reference samples.
}
\details{
Start with \code{\link{interval_actions}} for dose decisions and
\code{\link{minimum_certificate}} for supporting reports.
\code{\link{replay_results}} reconstructs the saved analyses from the separate
full reproducibility bundle. Datasets, manuscripts and saved results are not
included in the package.
}
\author{Siyi Chen}
\seealso{\code{\link{run_analysis}}}
